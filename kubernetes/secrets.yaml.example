# Kubernetes Secrets Example
# Kubernetes Secrets 示例
#
# Secrets 存储敏感数据（密码、API 密钥、证书）。
# 绝对不要将 secrets 提交到版本控制！
# 此文件是模板 - 复制并填入实际值。
#
# 学习目标：
# - 理解 Secrets 与 ConfigMaps 的区别
# - 创建和使用 Secrets
# - 将 secrets 注入到 Pod 中
# - 秘密管理的最佳实践

# 重要提示：这是示例文件
# 1. 复制到 secrets.yaml：cp secrets.yaml.example secrets.yaml
# 2. 填入实际值（base64 编码）
# 3. 将 secrets.yaml 添加到 .gitignore
# 4. 绝对不要将 secrets.yaml 提交到 Git！

apiVersion: v1
kind: Secret
metadata:
  name: model-api-secrets
  namespace: ml-serving
  labels:
    app: model-api

# ========================================================================
# SECRET 类型
# ========================================================================

# TODO: 设置 secret 类型
# 常见类型：
# - Opaque：任意用户定义数据（默认，最常用）
# - kubernetes.io/tls：TLS 证书和密钥
# - kubernetes.io/dockerconfigjson：Docker 注册表凭证
# - kubernetes.io/service-account-token：服务账户令牌
type: Opaque

# ========================================================================
# SECRET 数据（Base64 编码）
# ========================================================================

# TODO: 添加 secret 数据
# 所有值必须进行 base64 编码！
# 编码：echo -n "my-secret-value" | base64
# 解码：echo "bXktc2VjcmV0LXZhbHVl" | base64 -d

data:
  # 示例：外部服务的 API 密钥
  # TODO: 替换为实际的 base64 编码 API 密钥
  # api-key: ""  示例：echo -n "sk-1234567890abcdef" | base64

  # 示例：数据库密码
  # TODO: 替换为实际的 base64 编码密码
  # db-password: ""  示例：echo -n "MySecretPassword123!" | base64

  # 示例：JWT 密钥
  # TODO: 替换为实际的 base64 编码密钥
  # jwt-secret: ""  示例：echo -n "super-secret-jwt-key" | base64

  # 示例：带凭证的模型下载 URL
  # TODO: 替换为实际的 base64 编码 URL
  # model-url: ""  示例：echo -n "https://user:pass@models.example.com/model.pt" | base64

# ========================================================================
# SECRET 数据（明文 - 谨慎使用）
# ========================================================================

# 替代方案：使用 stringData 存储明文（自动 base64 编码）
# 警告：在 manifest 中仍然可见！只是稍微方便一些。

# stringData:
#   api-key: "sk-1234567890abcdef"        # 未 base64 编码
#   db-password: "MySecretPassword123!"   # 未 base64 编码

# 使用 stringData 的场景：
# - 手动创建 secrets 用于测试
# - 值已经是明文

# 不要使用 stringData 的场景：
# - 文件在版本控制中
# - 与他人共享 manifest

---

# ============================================================================
# TLS SECRET 示例
# ============================================================================

# 用于 SSL/TLS 证书（与 Ingress 配合使用）

# apiVersion: v1
# kind: Secret
# metadata:
#   name: model-api-tls
#   namespace: ml-serving
# type: kubernetes.io/tls
# data:
#   # Base64 编码的证书
#   tls.crt: ""  # cat cert.crt | base64 -w 0
#
#   # Base64 编码的私钥
#   tls.key: ""  # cat cert.key | base64 -w 0

# 从文件创建 TLS Secret：
#   kubectl create secret tls model-api-tls \
#     --cert=path/to/cert.crt \
#     --key=path/to/cert.key \
#     -n ml-serving

---

# ============================================================================
# DOCKER 注册表 SECRET 示例
# ============================================================================

# 用于从私有 Docker 注册表拉取镜像

# apiVersion: v1
# kind: Secret
# metadata:
#   name: docker-registry-secret
#   namespace: ml-serving
# type: kubernetes.io/dockerconfigjson
# data:
#   .dockerconfigjson: ""  # Base64 编码的 Docker 配置

# 创建 Docker 注册表 Secret：
#   kubectl create secret docker-registry docker-registry-secret \
#     --docker-server=https://index.docker.io/v1/ \
#     --docker-username=myusername \
#     --docker-password=mypassword \
#     --docker-email=myemail@example.com \
#     -n ml-serving

# 在 Pod 中使用：
#   spec:
#     imagePullSecrets:
#     - name: docker-registry-secret
#     containers:
#     - name: my-container
#       image: myregistry.com/my-private-image:latest

---

# ============================================================================
# SECRET 创建方法
# ============================================================================

# 方法 1：从 YAML 文件（此文件）
#   kubectl apply -f secrets.yaml -n ml-serving

# 方法 2：从字面值
#   kubectl create secret generic model-api-secrets \
#     --from-literal=api-key=sk-1234567890abcdef \
#     --from-literal=db-password=MyPassword123 \
#     -n ml-serving

# 方法 3：从文件
#   kubectl create secret generic model-api-secrets \
#     --from-file=api-key=./api-key.txt \
#     --from-file=db-password=./db-password.txt \
#     -n ml-serving

# 方法 4：使用 kustomize（推荐用于 GitOps）
#   # kustomization.yaml 中的 secretGenerator
#   secretGenerator:
#   - name: model-api-secrets
#     literals:
#     - api-key=sk-1234567890abcdef
#     - db-password=MyPassword123

---

# ============================================================================
# 在 POD 中使用 SECRETS
# ============================================================================

# 使用 secrets 的 Deployment 示例：

# apiVersion: apps/v1
# kind: Deployment
# metadata:
#   name: model-api
# spec:
#   template:
#     spec:
#       containers:
#       - name: model-api
#         image: model-api:v1.0

#         # 方法 1：使用 Secret 的环境变量
#         env:
#         - name: API_KEY
#           valueFrom:
#             secretKeyRef:
#               name: model-api-secrets
#               key: api-key
#         - name: DB_PASSWORD
#           valueFrom:
#             secretKeyRef:
#               name: model-api-secrets
#               key: db-password

#         # 方法 2：所有 secrets 作为环境变量
#         envFrom:
#         - secretRef:
#             name: model-api-secrets
#         # 创建环境变量：api-key、db-password 等

#         # 方法 3：将 secrets 挂载为文件
#         volumeMounts:
#         - name: secret-volume
#           mountPath: /etc/secrets
#           readOnly: true
#         # 创建文件：/etc/secrets/api-key、/etc/secrets/db-password

#       volumes:
#       - name: secret-volume
#         secret:
#           secretName: model-api-secrets
#           # 可选：指定要挂载的 keys
#           items:
#           - key: api-key
#             path: api-key.txt
#           - key: db-password
#             path: db-password.txt

---

# ============================================================================
# SECRET 安全最佳实践
# ============================================================================

# 1. 绝对不要将 secrets 提交到版本控制
#    - 将 secrets.yaml 添加到 .gitignore
#    - 使用 secrets.yaml.example 作为模板
#    - 在 CI/CD 或手动填充 secrets

# 2. 使用外部 secret 管理器（生产环境）
#    - AWS Secrets Manager
#    - GCP Secret Manager
#    - Azure Key Vault
#    - HashiCorp Vault
#    - External Secrets Operator (https://external-secrets.io/)

# 3. 启用静态加密
#    - Kubernetes secrets 只是 base64 编码（未加密！）
#    - 在 etcd 中启用静态加密
#    - 对于 EKS：使用 AWS KMS
#    - 对于 GKE：默认启用加密
#    - 对于 AKS：使用 Azure Key Vault

# 4. 使用 RBAC 限制 secret 访问
#    - 仅向必要的 ServiceAccount 授予 secret 读取权限
#    - 对不同信任级别使用独立的命名空间
#    - 审计 secret 访问

# 5. 定期轮换 secrets
#    - 自动轮换（AWS Secrets Manager、Vault）
#    - 记录轮换程序
#    - 测试轮换过程

# 6. 使用不可变 secrets（Kubernetes 1.21+）
#    - 防止意外修改
#    - 更好的性能（缓存，不监视）
#    - immutable: true

# 7. 扫描泄露的 secrets
#    - 使用工具：git-secrets、truffleHog、GitGuardian
#    - 使用 pre-commit hooks 防止提交
#    - 扫描 Git 历史中意外提交的 secrets

---

# ============================================================================
# SECRET 管理工作流
# ============================================================================

# 开发工作流：
#   1. 使用 secrets.yaml.example 作为模板
#   2. 在本地创建 secrets.yaml（已 gitignore）
#   3. 填入开发 secrets（不要使用生产环境的！）
#   4. 应用：kubectl apply -f secrets.yaml -n ml-serving

# CI/CD 工作流：
#   1. 将 secrets 存储在 CI/CD 系统中（GitHub Secrets、GitLab CI Variables）
#   2. 在 pipeline 中以编程方式创建 secrets：
#      kubectl create secret generic model-api-secrets \
#        --from-literal=api-key=$API_KEY \
#        --from-literal=db-password=$DB_PASSWORD \
#        -n ml-serving

# 生产工作流（External Secrets Operator）：
#   1. 将 secrets 存储在外部系统（AWS Secrets Manager）
#   2. 创建 ExternalSecret 资源引用外部 secret
#   3. External Secrets Operator 同步到 Kubernetes Secret
#   4. 外部 secret 更改时自动轮换

# ExternalSecret 示例：
#   apiVersion: external-secrets.io/v1beta1
#   kind: ExternalSecret
#   metadata:
#     name: model-api-secrets
#   spec:
#     secretStoreRef:
#       name: aws-secrets-manager
#       kind: SecretStore
#     target:
#       name: model-api-secrets
#     data:
#     - secretKey: api-key
#       remoteRef:
#         key: prod/model-api/api-key

---

# ============================================================================
# 查看和调试 SECRETS
# ============================================================================

# 列出 secrets：
#   kubectl get secrets -n ml-serving

# 描述 secret（不显示值）：
#   kubectl describe secret model-api-secrets -n ml-serving

# 查看 secret（显示 base64 编码的值）：
#   kubectl get secret model-api-secrets -n ml-serving -o yaml

# 解码 secret 值：
#   kubectl get secret model-api-secrets -n ml-serving -o jsonpath='{.data.api-key}' | base64 -d

# 查看 secret 中的所有 keys：
#   kubectl get secret model-api-secrets -n ml-serving -o json | jq -r '.data | keys[]'

# 检查 Pod 是否可以访问 secret：
#   kubectl exec <pod-name> -n ml-serving -- env | grep API_KEY
#   kubectl exec <pod-name> -n ml-serving -- cat /etc/secrets/api-key

---

# ============================================================================
# 故障排查
# ============================================================================

# Secret 未找到：
#   kubectl get secret model-api-secrets -n ml-serving
#   # 验证 secret 是否存在于正确的命名空间

# Pod 无法读取 secret：
#   kubectl describe pod <pod-name> -n ml-serving
#   # 检查 Events 区域查找 "Secret not found" 错误
#   # 验证 Deployment 中 secret 名称和 key 匹配

# Base64 编码无效：
#   echo "bXktc2VjcmV0LXZhbHVl" | base64 -d
#   # 应该成功解码
#   # 如果不成功，重新编码：echo -n "value" | base64

# 环境变量未设置：
#   kubectl exec <pod-name> -n ml-serving -- env
#   # 验证 SECRET 环境变量是否出现
#   # 检查 secretKeyRef 名称和 key

# 权限被拒绝：
#   kubectl auth can-i get secret model-api-secrets -n ml-serving
#   # 检查 RBAC 权限

---

# ============================================================================
# Kubernetes Secrets 的替代方案
# ============================================================================

# 1. External Secrets Operator
#    - 从外部 secret 存储同步
#    - 支持 AWS、GCP、Azure、Vault
#    - 自动轮换

# 2. Sealed Secrets
#    - 加密 secrets 用于 Git 存储
#    - Controller 在集群中解密
#    - 可以安全提交加密的 secrets

# 3. HashiCorp Vault
#    - 集中式 secret 管理
#    - 动态 secrets
#    - 审计日志
#    - 细粒度访问控制

# 4. 云提供商 secret 管理器
#    - AWS Secrets Manager
#    - GCP Secret Manager
#    - Azure Key Vault
#    - 与云 IAM 集成

# 5. SOPS (Secrets OPerationS)
#    - 加密 YAML 文件
#    - 与 Git 配合使用
#    - 应用时解密

---

